# Базовий образ із Node.js для React-проєкту.
FROM node:22-alpine

# Усі наступні команди виконуються в цій директорії контейнера.
WORKDIR /app

# Окремо копіюємо маніфести, щоб повторно використовувати кеш залежностей.
COPY package.json package-lock.json ./
RUN npm ci

# Додаємо вихідний код і файли конфігурації.
COPY . .

# Сервер Vite слухає цей порт усередині контейнера.
EXPOSE 5173

# Запускаємо застосунок; доступ ззовні налаштовує docker run -p.
CMD ["npm", "run", "dev"]
